  {
    "title": "Car Dealership Tycoon Script Event | Auto Farm (NO KEY)",
    "game": "Car Dealership Tycoon [🎃]",
    "icon": "/assets/icons/roblox-car-dealership-tycoon.png",
    "loadstring": "local Workspace = game:GetService(\"Workspace\")\nlocal Players = game:GetService(\"Players\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal LP = Players.LocalPlayer\n\nlocal CONFIG = {\n    Enabled = false,\n    FlySpeed = 300,\n    MaxSize = 10,\n    WaitTime = 30,\n}\n\nlocal blacklistedZones = {}\n\nlocal sg = Instance.new(\"ScreenGui\")\nsg.Name = \"PumpkinFarmGUI\"\nsg.ResetOnSpawn = false\nsg.Parent = LP:WaitForChild(\"PlayerGui\")\n\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 220, 0, 140)\nframe.Position = UDim2.new(0.5, -110, 0, 50)\nframe.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nframe.BorderSizePixel = 2\nframe.BorderColor3 = Color3.fromRGB(255, 140, 0)\nframe.Parent = sg\n\nlocal btnAutoFarm = Instance.new(\"TextButton\")\nbtnAutoFarm.Size = UDim2.new(1, -20, 0, 45)\nbtnAutoFarm.Position = UDim2.new(0, 10, 0, 10)\nbtnAutoFarm.BackgroundColor3 = Color3.fromRGB(200, 50, 50)\nbtnAutoFarm.TextColor3 = Color3.fromRGB(255, 255, 255)\nbtnAutoFarm.Font = Enum.Font.SourceSansBold\nbtnAutoFarm.TextSize = 18\nbtnAutoFarm.Text = \"AUTO-FARM: OFF\"\nbtnAutoFarm.Parent = frame\n\nlocal btnExclude = Instance.new(\"TextButton\")\nbtnExclude.Size = UDim2.new(1, -20, 0, 45)\nbtnExclude.Position = UDim2.new(0, 10, 0, 65)\nbtnExclude.BackgroundColor3 = Color3.fromRGB(255, 140, 0)\nbtnExclude.TextColor3 = Color3.fromRGB(255, 255, 255)\nbtnExclude.Font = Enum.Font.SourceSansBold\nbtnExclude.TextSize = 16\nbtnExclude.Text = \"EXCLUDE THIS PLACE\"\nbtnExclude.Parent = frame\n\nlocal statusLabel = Instance.new(\"TextLabel\")\nstatusLabel.Size = UDim2.new(1, -20, 0, 30)\nstatusLabel.Position = UDim2.new(0, 10, 0, 115)\nstatusLabel.BackgroundTransparency = 1\nstatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)\nstatusLabel.Font = Enum.Font.SourceSans\nstatusLabel.TextSize = 14\nstatusLabel.Text = \"Status: Waiting...\"\nstatusLabel.Parent = frame\n\nbtnAutoFarm.MouseButton1Click:Connect(function()\n    CONFIG.Enabled = not CONFIG.Enabled\n    btnAutoFarm.Text = CONFIG.Enabled and \"AUTO-FARM: ON\" or \"AUTO-FARM: OFF\"\n    btnAutoFarm.BackgroundColor3 = CONFIG.Enabled and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)\nend)\n\nbtnExclude.MouseButton1Click:Connect(function()\n    local char = LP.Character\n    if char and char:FindFirstChild(\"HumanoidRootPart\") then\n        table.insert(blacklistedZones, char.HumanoidRootPart.Position)\n        btnExclude.Text = \"ZONE ADDED!\"\n        task.wait(1)\n        btnExclude.Text = \"EXCLUDE THIS PLACE\"\n    end\nend)\n\nlocal function isBlacklisted(pos)\n    for _, zone in ipairs(blacklistedZones) do\n        if (pos - zone).Magnitude < 150 then return true end\n    end\n    return false\nend\n\nlocal function isRealPumpkin(obj)\n    local name = obj.Name:lower()\n    local parentName = obj.Parent and obj.Parent.Name:lower() or \"\"\n    \n    local nameMatch = name:find(\"pumpkin\") or name:find(\"halloween\") or name:find(\"jack\") or\n                      parentName:find(\"pumpkin\")\n                      \n    local hasInteractive = obj:FindFirstChildOfClass(\"ClickDetector\") or \n                           obj:FindFirstChildOfClass(\"ProximityPrompt\") or\n                           (obj.Parent and obj.Parent:FindFirstChildOfClass(\"ClickDetector\"))\n                           \n    return nameMatch or hasInteractive\nend\n\nlocal function findPumpkins()\n    local list = {}\n    for _, child in ipairs(Workspace:GetDescendants()) do\n        if child:IsA(\"BasePart\") or child:IsA(\"MeshPart\") then\n            local s = child.Size\n            if math.max(s.X, s.Y, s.Z) <= CONFIG.MaxSize \n               and not child:IsDescendantOf(LP.Character) \n               and not isBlacklisted(child.Position)\n               and isRealPumpkin(child) then\n                table.insert(list, child)\n            end\n        end\n    end\n    return list\nend\n\nlocal function flyTo(target)\n    local char = LP.Character\n    if not char then return end\n    local hrp = char:FindFirstChild(\"HumanoidRootPart\")\n    if not hrp then return end\n\n    local dist = (target.Position - hrp.Position).Magnitude\n    local duration = math.clamp(dist / CONFIG.FlySpeed, 0.1, 3)\n    \n    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(target.Position + Vector3.new(0, 2, 0))})\n    tween:Play()\n    tween.Completed:Wait()\n    \n    local click = target:FindFirstChildOfClass(\"ClickDetector\") or (target.Parent and target.Parent:FindFirstChildOfClass(\"ClickDetector\"))\n    if click and fireclickdetector then\n        fireclickdetector(click)\n    end\nend\n\ntask.spawn(function()\n    while true do\n        if CONFIG.Enabled then\n            local pumpkins = findPumpkins()\n            \n            if #pumpkins > 0 then\n                local hrp = LP.Character and LP.Character:FindFirstChild(\"HumanoidRootPart\")\n                if hrp then\n                    table.sort(pumpkins, function(a, b)\n                        return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude\n                    end)\n                end\n                \n                for _, p in ipairs(pumpkins) do\n                    if not CONFIG.Enabled then break end\n                    if p.Parent then\n                        statusLabel.Text = \"Status: Collecting (\" .. #pumpkins .. \" left)\"\n                        flyTo(p)\n                        task.wait(0.3)\n                    end\n                end\n            else\n                statusLabel.Text = \"Status: Waiting respawn (30s)\"\n                local timeLeft = CONFIG.WaitTime\n                while timeLeft > 0 and CONFIG.Enabled do\n                    statusLabel.Text = \"Status: Waiting respawn (\" .. timeLeft .. \"s)\"\n                    task.wait(1)\n                    timeLeft = timeLeft - 1\n                end\n            end\n        else\n            statusLabel.Text = \"Status: Off\"\n            task.wait(0.5)\n        end\n        task.wait(0.5)\n    end\nend)",
    "features": "Auto Farm (NO KEY)",
    "keyRequired": false
  },
